{
  "name": "heisen-sms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "test": "tsx --test src/lib/*.test.ts",
    "db:migrate:platform": "node scripts/apply-platform-migration.mjs",
    "db:migrate:staff-invitations": "node scripts/apply-staff-invitations-migration.mjs",
    "db:migrate:timetable": "node scripts/apply-timetable-migration.mjs",
    "db:migrate:default-stream": "node scripts/apply-default-stream-migration.mjs",
    "db:migrate:curriculum": "node -e \"import('./scripts/apply-curriculum-migration.mjs')\"",
    "db:migrate:feeding": "node scripts/apply-feeding-migration.mjs",
    "db:migrate:cashbook": "node scripts/apply-cashbook-migration.mjs",
    "db:migrate:cashbook-links": "node scripts/apply-cashbook-source-links-migration.mjs",
    "db:migrate:cashbook-reversals": "node scripts/apply-cashbook-reversals-migration.mjs",
    "db:seed:curriculum": "node scripts/seed-curriculum.mjs",
    "db:reset:deployment": "node scripts/reset-for-deployment.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "seed:platform": "tsx --tsconfig tsconfig.json scripts/seed-platform.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/auth-ui": "^0.3.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
